# Maintainer: Gonçalo Gomes <goncalo98gomes at gmail dot com>
pkgname=visor-git
_pkgname=visor
pkgver=0.1.0
pkgrel=1
pkgdesc="A little robot for your Wayland desktop that shows what your AI is up to, with a chat popup (Claude Code, OpenAI-compatible APIs, local models)"
arch=('any')
url="https://github.com/goncalomgomes/visor"
license=('MIT')
depends=('quickshell' 'python')
optdepends=('inter-font: the popups\' typeface'
            'jq: Claude Code hook'
            'grim: let the chat see your screen'
            'curl: weather'
            'brightnessctl: brightness reactions'
            'wtype: computer use (typing)'
            'claude-code: the Claude Code backend')
makedepends=('git')
provides=('visor')
conflicts=('visor')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd "$_pkgname"
    printf "0.1.0.r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
    cd "$_pkgname"
    install -d "$pkgdir/usr/share/$_pkgname"
    cp -r bin backend quickshell themes adapters extras scripts config.example.json "$pkgdir/usr/share/$_pkgname/"
    find "$pkgdir/usr/share/$_pkgname" -name __pycache__ -prune -exec rm -rf {} +
    install -d "$pkgdir/usr/bin"
    ln -s "/usr/share/$_pkgname/bin/visor" "$pkgdir/usr/bin/visor"
    install -Dm644 packaging/systemd/visor.service "$pkgdir/usr/lib/systemd/user/visor.service"
    sed -i 's|^ExecStart=.*|ExecStart=/usr/bin/visor start|' "$pkgdir/usr/lib/systemd/user/visor.service"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$_pkgname/README.md"
}
